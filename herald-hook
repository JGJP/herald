#!/bin/sh
# Claude Code Stop/Notification hook for herald.
# Guarded by $HERALD_LABEL so it is a no-op for normal (non-herald) Claude sessions.
# Identity ($HERALD_LABEL) and $HERALD_STATE are inherited from the launching `claude`.
# The event name is passed as $1; the controller reads the file's mtime for timing.
[ -n "$HERALD_LABEL" ] || exit 0
dir="${HERALD_STATE:-$HOME/_dev/herald/state}"
mkdir -p "$dir"
# HERALD_PANE (set on numbered claude panes, `:2`/`::` …) suffixes the state file so each
# lane's claude reports independently; lane 1 (unset) keeps the bare `<label>.json`.
suffix="${HERALD_PANE:+.$HERALD_PANE}"
{ printf '{"event":"%s","raw":' "$1"; cat; printf '}\n'; } > "$dir/$HERALD_LABEL$suffix.json"
